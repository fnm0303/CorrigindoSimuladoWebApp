@using CorrigindoSimuladoWebApp.Modulos.Correcoes.Apresentacao
@model List<ListarCorrecaoViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Correções";
}
<div class="container-fluid px-0 mt-4">

    <!-- Cabeçalho da Tela -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #0f2d59; letter-spacing: -0.5px;">
                <i class="bi bi-file-earmark-text-fill"></i> Correções: @ViewBag.NomeProva
            </h2>
            <p class="text-muted mb-0">Gerencie as correções e os acertos dos alunos nesta prova.</p>
        </div>

        <div>
            <a asp-action="ListarProvasCorrigidas" class="btn bg-white shadow-sm rounded-pill px-4"
               style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                <i class="bi bi-arrow-return-left me-2"></i> Voltar
            </a>
        </div>
    </div>

    <!-- Grid de Cards de Correções -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var correcao in Model)
            {
                <!-- Card da Correção -->
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 border-start border-5 position-relative hover-card"
                         style="border-color: #0f2d59 !important;">
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Ícone e Tag de Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 48px; height: 48px;">
                                    <i class="bi bi-person-check-fill fs-3" style="color: #0f2d59;"></i>
                                </div>
                                <span class="badge bg-light text-dark border rounded-pill fw-semibold shadow-sm">
                                    Corrigida
                                </span>
                            </div>

                            <!-- Nome do Aluno -->
                            <h5 class="card-title fw-bold mb-2 text-truncate" style="color: #0f2d59;"
                                title="@correcao.NomeAluno">
                                @correcao.NomeAluno
                            </h5>

                            <!-- Badges de Informação (Prova e Acertos) -->
                            <div class="mb-4 d-flex flex-column gap-2">
                                <span class="badge rounded-pill fw-normal px-3 py-2 text-start text-truncate"
                                      style="background-color: #f0f4f8; color: #0f2d59; border: 1px solid #dce4ec;">
                                    <i class="bi bi-file-earmark me-1"></i>
                                    Prova: @correcao.NomeProva
                                </span>

                                <span class="badge rounded-pill fw-normal px-3 py-2 text-start"
                                      style="background-color: #e3ebe3; color: #0f2d59; border: 1px solid #c9d8c9;">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Acertos: @correcao.NumeroAcertos
                                </span>
                            </div>

                            <!-- Botões de Ação -->
                            <div class="mt-auto d-flex gap-2">
                                <a asp-controller="Correcao" asp-action="DetalharCorrecao" asp-route-id="@correcao.Id"
                                   class="btn text-white flex-grow-1 rounded-pill fw-semibold shadow-sm px-2 py-2"
                                   style="background-color: #0f2d59;">
                                    <i class="bi bi-card-list"></i> Detalhes
                                </a>

                                <button type="button"
                                        class="btn btn-outline-danger flex-grow-1 rounded-pill fw-semibold shadow-sm px-2 py-2"
                                        data-bs-toggle="modal" data-bs-target="#modalExcluir-@correcao.Id">
                                    <i class="bi bi-trash"></i> Excluir
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Janela de Confirmação (Modal Bootstrap) -->
                <div class="modal fade text-start" id="modalExcluir-@correcao.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4">

                            <!-- Cabeçalho do Modal -->
                            <div class="modal-header text-white border-0"
                                 style="background-color: #0f2d59; border-top-left-radius: var(--bs-border-radius-xl); border-top-right-radius: var(--bs-border-radius-xl);">
                                <h5 class="modal-title fs-5 d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-exclamation"></i> Confirmar Exclusão
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                        aria-label="Fechar"></button>
                            </div>

                            <!-- Corpo do Modal -->
                            <div class="modal-body p-4 text-center">
                                <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                                <p class="fs-5 text-dark mb-1">
                                    Deseja realmente excluir a correção do aluno<br />
                                    <strong>@correcao.NomeAluno</strong>?
                                </p>
                                <span class="text-muted small">Esta ação não poderá ser desfeita.</span>
                            </div>

                            <!-- Rodapé do Modal (Ações) -->
                            <div class="modal-footer bg-light border-0 justify-content-center"
                                 style="border-bottom-left-radius: var(--bs-border-radius-xl); border-bottom-right-radius: var(--bs-border-radius-xl);">
                                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">
                                    <i class="bi bi-arrow-return-left"></i> Voltar
                                </button>

                                <form asp-controller="Correcao" asp-action="Excluir" asp-route-id="@correcao.Id" method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                                        <i class="bi bi-trash"></i> Sim, Excluir
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Estado Vazio (Nenhuma Correção) -->
            <div class="col-12">
                <div class="p-5 bg-white shadow-sm rounded-4 border-0 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/3273/3273180.png" alt="Sem dados"
                         style="width: 120px; opacity: 0.5;" class="mb-4" />
                    <h4 class="text-dark fw-bold mb-2">Nenhuma correção cadastrada</h4>
                    <p class="text-muted fs-6 mb-0">
                        Não existem correções lançadas no momento para a prova <strong>@ViewBag.NomeProva</strong>.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Estilo Hover Padrão -->
<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(15, 45, 89, 0.1) !important;
    }
</style>