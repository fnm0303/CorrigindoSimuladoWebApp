@using CorrigindoSimuladoWebApp.Modulos.Correcoes.Apresentacao
@model DetalhesCorrecaoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Correção";

    // Cálculo de aproveitamento para pintar a nota (Verde se > 60%, Vermelho se menor)
    double aproveitamento = (double)Model.Acertos / Model.TotalQuestoes * 100;
    string corNota = aproveitamento >= 60 ? "text-success" : "text-danger";
}

<div class="container-fluid px-0 mt-4">

    <!-- Cabeçalho da Tela -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #0f2d59; letter-spacing: -0.5px;">
                <i class="bi bi-clipboard2-data-fill"></i> Resultado Detalhado
            </h2>
            <p class="text-muted mb-0">Confira o desempenho do aluno questão por questão.</p>
        </div>

        <div>
            <a asp-action="Listar" class="btn bg-white shadow-sm rounded-pill px-4"
               style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                <i class="bi bi-arrow-return-left me-2"></i> Voltar à Lista
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <!-- Card de Resumo do Aluno -->
            <div class="card shadow-sm border-0 rounded-4 border-start border-5 mb-4"
                 style="border-color: #0f2d59 !important;">
                <div
                    class="card-body p-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-4">

                    <!-- Info do Aluno -->
                    <div class="d-flex align-items-center gap-3 text-center text-md-start">
                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 d-none d-sm-flex"
                             style="width: 64px; height: 64px;">
                            <i class="bi bi-person-bounding-box fs-2" style="color: #0f2d59;"></i>
                        </div>
                        <div>
                            <h4 class="mb-1 fw-bold text-dark">@Model.NomeAluno</h4>
                            <p class="mb-0 text-muted fs-6">
                                <i class="bi bi-file-earmark-text me-1"></i> Prova: <strong
                                style="color: #0f2d59;">@Model.NomeProva</strong>
                            </p>
                        </div>
                    </div>

                    <!-- Placar de Acertos -->
                    <div class="text-center bg-light rounded-4 px-4 py-3 border shadow-sm" style="min-width: 200px;">
                        <span class="d-block text-muted small text-uppercase fw-bold mb-1">Total de Acertos</span>
                        <h1
                            class="display-5 fw-bold mb-0 @corNota d-flex align-items-baseline justify-content-center gap-1">
                            @Model.Acertos <span class="fs-4 text-muted">/ @Model.TotalQuestoes</span>
                        </h1>
                    </div>

                </div>
            </div>

            <!-- Card da Tabela de Questões -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white mb-5">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background-color: #0f2d59; color: white;">
                            <tr>
                                <th class="ps-4 text-center py-3" style="width: 15%; font-weight: 600;">Questão</th>
                                <th class="text-center py-3" style="width: 25%; font-weight: 600;">Gabarito Correto</th>
                                <th class="text-center py-3" style="width: 25%; font-weight: 600;">Resposta do Aluno
                                </th>
                                <th class="text-center py-3 pe-4" style="width: 35%; font-weight: 600;">Situação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var questao in Model.Questoes)
                            {
                                <tr>
                                    <!-- Número da Questão -->
                                    <td class="ps-4 text-center fw-bold text-muted" style="font-size: 1.1rem;">
                                        @questao.NumeroQuestao
                                    </td>

                                    <!-- Gabarito -->
                                    <td class="text-center fw-semibold text-dark">
                                        <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-3 shadow-sm">
                                            @questao.RespostaCorreta
                                        </span>
                                    </td>

                                    <!-- Resposta do Aluno (Fica verde ou vermelha sutilmente) -->
                                    <td class="text-center fw-semibold">
                                        <span
                                            class="badge px-3 py-2 fs-6 rounded-3 shadow-sm @(questao.Acertou ? "bg-success bg-opacity-10 text-success border border-success border-opacity-25" : "bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25")">
                                            @questao.RespostaAluno
                                        </span>
                                    </td>

                                    <!-- Situação / Status -->
                                    <td class="text-center pe-4 py-3">
                                        @if (questao.Acertou)
                                        {
                                            <span
                                                class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-4 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correta
                                            </span>
                                        }
                                        else
                                        {
                                            <span
                                                class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-4 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-x-circle-fill me-1"></i> Incorreta
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>