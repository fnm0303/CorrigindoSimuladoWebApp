@using CorrigindoSimuladoWebApp.Modulos.Correcoes.Apresentacao
@model DetalhesCorrecaoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Detalhes da Correção";

    // Cálculo de aproveitamento para pintar a nota (Verde se > 60%, Vermelho se menor)
    double aproveitamento = (double)Model.Acertos / Model.TotalQuestoes * 100;
    string corNota = aproveitamento >= 60 ? "text-success" : "text-danger";
}

<div class="row justify-content-center mt-4">
    <div class="col-12 col-md-10 col-lg-10 col-xl-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 style="color: #0f2d59;" class="fw-bold mb-0">Resultado Detalhado</h2>
            <a class="btn btn-outline-secondary" asp-action="Listar">
                <i class="bi bi-arrow-return-left"></i> Voltar à Lista
            </a>
        </div>

        <!-- Card de Resumo -->
        <div class="card shadow-sm border-0 bg-white mb-4">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1 text-dark">@Model.NomeAluno</h4>
                    <p class="mb-0 text-muted fs-5">Prova: <strong>@Model.NomeProva</strong></p>
                </div>
                <div class="text-end">
                    <span class="d-block text-muted small text-uppercase fw-bold mb-1">Acertos</span>
                    <h1 class="display-4 fw-bold mb-0 @corNota">
                        @Model.Acertos <span class="fs-4 text-muted">/ @Model.TotalQuestoes</span>
                    </h1>
                </div>
            </div>
        </div>

        <!-- Tabela de Questões -->
        <div class="card shadow-sm border-0 bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8f9fa; color: #0f2d59;">
                        <tr>
                            <th class="ps-4 text-center" style="width: 15%;">Questão</th>
                            <th class="text-center" style="width: 25%;">Gabarito Correto</th>
                            <th class="text-center" style="width: 25%;">Resposta do Aluno</th>
                            <th class="text-center" style="width: 35%;">Situação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var questao in Model.Questoes)
                        {
                            <tr>
                                <td class="ps-4 text-center fw-bold text-muted">@questao.NumeroQuestao</td>

                                <td class="text-center fw-semibold">
                                    @questao.RespostaCorreta
                                </td>

                                <td class="text-center fw-semibold">
                                    @questao.RespostaAluno
                                </td>

                                <td class="text-center">
                                    @if (questao.Acertou)
                                    {
                                        <span
                                            class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Correta
                                        </span>
                                    }
                                    else
                                    {
                                        <span
                                            class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                                            <i class="bi bi-x-circle-fill me-1"></i> Incorreta
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>