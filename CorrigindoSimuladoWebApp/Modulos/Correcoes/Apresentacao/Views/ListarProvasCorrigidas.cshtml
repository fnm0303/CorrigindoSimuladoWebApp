@using CorrigindoSimuladoWebApp.Modulos.Correcoes.Apresentacao
@model IEnumerable<ListarProvasCorrigidasViewModel>

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Selecionar Prova para Listagem";
}

<div class="container-fluid px-0 mt-4">

    <!-- Cabeçalho da Tela -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2" style="color: #0f2d59; letter-spacing: -0.5px;">
                <i class="bi bi-file-earmark-bar-graph-fill"></i> Listar Correções
            </h2>
            <p class="text-muted mb-0">Selecione a prova que deseja visualizar as notas dos alunos.</p>
        </div>

        <div>
            <a asp-action="IndexCorrecoes" class="btn bg-white shadow-sm rounded-pill px-4"
               style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                <i class="bi bi-arrow-return-left me-2"></i> Voltar
            </a>
        </div>
    </div>

    <!-- Grid de Cards de Provas -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var prova in Model)
            {
                <!-- Card da Prova -->
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 border-0 shadow-sm rounded-4 border-start border-5 position-relative hover-card"
                         style="border-color: #0f2d59 !important;">
                        <div class="card-body d-flex flex-column p-4">

                            <!-- Ícone e Tag de Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center"
                                     style="width: 48px; height: 48px;">
                                    <i class="bi bi-file-earmark-check-fill fs-3" style="color: #0f2d59;"></i>
                                </div>
                                <span class="badge bg-light text-dark border rounded-pill fw-semibold shadow-sm">
                                    Corrigida
                                </span>
                            </div>

                            <!-- Nome da Prova -->
                            <h5 class="card-title fw-bold mb-2 text-truncate" style="color: #0f2d59;" title="@prova.Nome">
                                @prova.Nome
                            </h5>

                            <!-- Badge da Turma -->
                            <div class="mb-4">
                                <span class="badge rounded-pill fw-normal px-3 py-2"
                                      style="background-color: #e3ebe3; color: #0f2d59; border: 1px solid #c9d8c9;">
                                    <i class="bi bi-people-fill me-1"></i>
                                    Turma: @prova.NomeTurma
                                </span>
                            </div>

                            <!-- Botão Ver Notas -->
                            <div class="mt-auto">
                                <a asp-action="Listar" asp-route-provaId="@prova.Id"
                                   class="btn text-white w-100 rounded-pill fw-semibold shadow-sm px-3 py-2"
                                   style="background-color: #0f2d59;">
                                    <i class="bi bi-list-check me-2"></i> Ver Notas
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Estado Vazio (Nenhuma Prova Corrigida) -->
            <div class="col-12">
                <div class="p-5 bg-white shadow-sm rounded-4 border-0 text-center">
                    <img src="https://cdn-icons-png.flaticon.com/512/3273/3273180.png" alt="Sem dados"
                         style="width: 120px; opacity: 0.5;" class="mb-4" />
                    <h4 class="text-dark fw-bold mb-2">Não há provas corrigidas no momento</h4>
                    <p class="text-muted fs-6 mb-0">
                        Quando as provas forem corrigidas, elas aparecerão nesta lista para consulta de notas.
                    </p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Estilo Hover Padrão -->
<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(15, 45, 89, 0.1) !important;
    }
</style>