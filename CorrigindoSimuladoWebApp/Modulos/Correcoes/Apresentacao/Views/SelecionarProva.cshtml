@{
    Layout = "_Layout";
    ViewBag.Titulo = "Selecionar Prova para Correção";
}

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">

        <!-- Formulário via GET envolvendo o card -->
        <form asp-controller="Correcao" asp-action="Cadastrar" method="get">

            <!-- Card Principal -->
            <div class="p-4 p-md-5 bg-white shadow-sm rounded-4 border-start border-5"
                 style="border-color: #0f2d59 !important;">

                <!-- Cabeçalho -->
                <div class="mb-4">
                    <h3 class="fw-bold mb-2 d-flex align-items-center flex-wrap gap-2"
                        style="color: #0f2d59; letter-spacing: -0.5px;">
                        <i class="bi bi-check2-square me-1"></i>Selecionar Prova

                        <!-- Badge temática -->
                        <span class="badge fs-6 rounded-pill fw-normal"
                              style="background-color: #e3ebe3; color: #0f2d59;">
                            Módulo de Correção
                        </span>
                    </h3>
                    <p class="text-muted fs-6 mb-0">Escolha a prova na lista abaixo para iniciar o processo de correção
                        dos gabaritos.</p>
                    </div>

                    <!-- Grid de Campos -->
                    <div class="row g-3 g-md-4">

                        <!-- Campo de Seleção (Linha inteira) -->
                        <div class="col-12">
                            <label for="provaId" class="form-label fw-semibold" style="color: #0f2d59;">Prova a ser
                                corrigida</label>
                                <select name="provaId" id="provaId" class="form-select form-select-lg shadow-sm" required>
                                    <option value="">Selecione uma prova...</option>
                                    @if (ViewBag.Provas != null)
                                    {
                                        foreach (var prova in ViewBag.Provas)
                                        {
                                            <option value="@prova.Id">@prova.Nome</option>
                                        }
                                    }
                                </select>
                                <!-- Texto de ajuda opcional -->
                                <div class="form-text mt-2 text-muted small">
                                    <i class="bi bi-info-circle me-1"></i>Apenas provas previamente cadastradas no sistema
                                    aparecem nesta lista.
                                </div>
                            </div>

                        </div>

                        <!-- Divisória -->
                        <hr class="my-4 text-muted" style="opacity: 0.15;">

                        <!-- Botões de Ação -->
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">

                            <!-- Botão Voltar -->
                            <a asp-controller="Correcao" asp-action="IndexCorrecoes"
                               class="btn btn-lg bg-white shadow-sm rounded-pill px-4 text-nowrap order-2 order-sm-1"
                               style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                <i class="bi bi-arrow-left me-2"></i>Voltar
                            </a>

                            <!-- Botão Continuar -->
                            <button type="submit"
                                    class="btn btn-lg text-white shadow-sm rounded-pill px-4 text-nowrap order-1 order-sm-2"
                                    style="background-color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                Continuar <i class="bi bi-arrow-right-circle fs-5 ms-2"></i>
                            </button>

                        </div>

                    </div>
                </form>

            </div>
        </div>