@model CadastrarTurmaViewModel
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Turma";
}

<div class="row justify-content-start">
    <form class="col-lg-6" asp-action="Cadastrar" method="post">
        <!-- Campo Nome -->
        <div class="mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <!-- Campo Curso (Dropdown gerado automaticamente pelo Enum) -->
        <div class="mb-3">
            <label asp-for="Curso" class="form-label"></label>
            <select asp-for="Curso" asp-items="Html.GetEnumSelectList<TipoCurso>()" class="form-select">
                <option value="">Selecione um curso...</option>
            </select>
            <span asp-validation-for="Curso" class="text-danger"></span>
        </div>

        <!-- Campo Ano Letivo -->
        <div class="mb-3">
            <label asp-for="AnoLetivo" class="form-label"></label>
            <input asp-for="AnoLetivo" type="number" class="form-control" />
            <span asp-validation-for="AnoLetivo" class="text-danger"></span>
        </div>

        <div class="d-flex gap-3 mt-4">
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-check"></i>
                Cadastrar
            </button>
            <a class="btn btn-outline-secondary" asp-action="IndexTurmas">
                <i class="bi bi-arrow-return-left"></i>
                Voltar
            </a>
        </div>
    </form>
</div>