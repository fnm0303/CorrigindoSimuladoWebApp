@model EditarTurmaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Edição de Turma";
}

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">

        <form asp-action="Editar" method="post">

            <!-- Id Oculto Necessário para o Editar -->
            <input asp-for="Id" type="hidden">

            <!-- Card Principal -->
            <div class="p-4 p-md-5 bg-white shadow-sm rounded-4 border-start border-5"
                 style="border-color: #0f2d59 !important;">

                <!-- Cabeçalho -->
                <div class="mb-4">
                    <h3 class="fw-bold mb-2 d-flex align-items-center flex-wrap gap-2"
                        style="color: #0f2d59; letter-spacing: -0.5px;">
                        <i class="bi bi-pencil-square me-1"></i>Editar Turma

                        <!-- Badge temática -->
                        <span class="badge fs-6 rounded-pill fw-normal"
                              style="background-color: #e3ebe3; color: #0f2d59;">
                            Turmas
                        </span>
                    </h3>
                    <p class="text-muted fs-6 mb-0">Atualize os dados e as configurações desta turma.</p>
                </div>

                <!-- Grid de Campos -->
                <div class="row g-3 g-md-4">

                    <!-- Campo Nome -->
                    <div class="col-12">
                        <label asp-for="Nome" class="form-label fw-semibold" style="color: #0f2d59;">Nome da
                            Turma</label>
                            <input asp-for="Nome" class="form-control form-control-lg shadow-sm"
                                   placeholder="Ex: 3º Ano A" />
                            <span asp-validation-for="Nome" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Campo Curso (Dropdown Enum) -->
                        <div class="col-12">
                            <label asp-for="Curso" class="form-label fw-semibold" style="color: #0f2d59;">Curso</label>
                            <select asp-for="Curso" asp-items="Html.GetEnumSelectList<TipoCurso>()"
                                    class="form-select form-select-lg shadow-sm">
                                <option value="">Selecione um curso...</option>
                            </select>
                            <span asp-validation-for="Curso" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Campo Ano Letivo -->
                        <div class="col-12">
                            <label asp-for="AnoLetivo" class="form-label fw-semibold" style="color: #0f2d59;">Ano
                                Letivo</label>
                                <div class="input-group input-group-lg shadow-sm">
                                    <span class="input-group-text bg-light text-muted border-end-0"><i
                                        class="bi bi-calendar-event"></i></span>
                                        <input asp-for="AnoLetivo" type="number" class="form-control border-start-0 ps-0"
                                               placeholder="Ex: 2024" />
                                    </div>
                                    <span asp-validation-for="AnoLetivo" class="text-danger small mt-1 d-block"></span>
                                </div>

                            </div>

                            <!-- Divisória -->
                            <hr class="my-4 text-muted" style="opacity: 0.15;">

                            <!-- Botões de Ação -->
                            <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">

                                <!-- Botão Voltar -->
                                <a asp-action="IndexTurmas"
                                   class="btn btn-lg bg-white shadow-sm rounded-pill px-4 text-nowrap order-2 order-sm-1"
                                   style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                    <i class="bi bi-arrow-left me-2"></i>Voltar
                                </a>

                                <!-- Botão Salvar (Trocado de "Cadastrar" para "Salvar Alterações") -->
                                <button type="submit"
                                        class="btn btn-lg text-white shadow-sm rounded-pill px-4 text-nowrap order-1 order-sm-2"
                                        style="background-color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                    <i class="bi bi-save fs-5 me-2"></i>Salvar Alterações
                                </button>

                            </div>

                        </div>
                    </form>

                </div>
            </div>