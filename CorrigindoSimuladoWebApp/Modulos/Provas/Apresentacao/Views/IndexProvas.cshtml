@{
    Layout = "_Layout";
    ViewBag.Titulo = "Provas";
}

<div class="row gap-3 gap-lg-0 mt-5">
    <div class="col-12 mb-4">

        <!-- Card Banner: Sombra suave, bordas arredondadas e detalhe lateral -->
        <div class="p-4 p-md-5 bg-white shadow-sm rounded-4 border-start border-5"
             style="border-color: #0f2d59 !important;">
            <div class="row align-items-center">

                <!-- Área de Texto -->
                <div class="col-12 col-xl-5 mb-4 mb-xl-0">
                    <h2 class="fw-bold mb-3" style="color: #0f2d59; letter-spacing: -0.5px;">
                        Módulo de Provas
                        <!-- Badge (Etiqueta) temática -->
                        <span class="badge fs-6 align-middle ms-2 rounded-pill fw-normal"
                              style="background-color: #e3ebe3; color: #0f2d59;">
                            <i class="bi bi-journal-check me-1"></i>Avaliação
                        </span>
                    </h2>

                    <!-- Descrição com cor suavizada (.text-muted) -->
                    <p class="fs-5 text-muted lh-base mb-0">
                        Gerencie as provas da instituição. Cadastre novas provas para o ano letivo, busque uma prova
                        específica ou visualize a lista completa.
                    </p>
                </div>

                <!-- Área de Ações Rápidas (Botões) -->
                <div class="col-12 col-xl-7">
                    <!-- Flexbox com flex-wrap para garantir responsividade perfeita com 3 botões -->
                    <div class="d-flex flex-column flex-md-row flex-wrap gap-3 justify-content-xl-end">

                        <!-- Botão Listar (Ação Secundária) -->
                        <a asp-controller="Prova" asp-action="Listar"
                           class="btn btn-lg bg-white shadow-sm d-flex align-items-center justify-content-center rounded-pill px-4 text-nowrap"
                           style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                            <i class="bi bi-list-ul fs-5 me-2"></i> Listar Provas
                        </a>

                        <!-- Botão Buscar (Ação Secundária) -->
                        <a asp-controller="Prova" asp-action="Buscar"
                           class="btn btn-lg bg-white shadow-sm d-flex align-items-center justify-content-center rounded-pill px-4 text-nowrap"
                           style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                            <i class="bi bi-search fs-5 me-2"></i> Buscar Provas
                        </a>

                        <!-- Botão Cadastrar (Ação Principal em Destaque) -->
                        <a asp-controller="Prova" asp-action="Cadastrar"
                           class="btn btn-lg text-white shadow-sm d-flex align-items-center justify-content-center rounded-pill px-4 text-nowrap"
                           style="background-color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                            <i class="bi bi-plus-circle fs-5 me-2"></i> Cadastrar Prova
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>