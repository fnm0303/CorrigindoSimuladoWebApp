@model CadastrarProvaViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Cadastro de Prova";
}

<div class="row justify-content-center my-3 my-md-4">
    <div class="col-12 col-md-10 col-lg-8 col-xl-7 col-xxl-6">

        <form asp-controller="Prova" asp-action="Cadastrar" method="post">

            <!-- Card Principal -->
            <div class="p-4 p-md-5 bg-white shadow-sm rounded-4 border-start border-5"
                 style="border-color: #0f2d59 !important;">

                <!-- Cabeçalho -->
                <div class="mb-4">
                    <h3 class="fw-bold mb-2" style="color: #0f2d59; letter-spacing: -0.5px;">
                        <i class="bi bi-file-earmark-text me-2"></i>Cadastrar Nova Prova
                    </h3>
                    <p class="text-muted fs-6 mb-0">Preencha os dados abaixo para registrar uma nova avaliação.</p>
                </div>

                <!-- Grid de Campos -->
                <div class="row g-3 g-md-4">

                    <!-- Nome da Prova (Linha inteira) -->
                    <div class="col-12">
                        <label asp-for="Nome" class="form-label fw-semibold" style="color: #0f2d59;">Nome da
                            Prova</label>
                            <input asp-for="Nome" class="form-control form-control-lg shadow-sm"
                                   placeholder="Ex: Simulado - 1º Bimestre" />
                            <span asp-validation-for="Nome" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Quantidade de Questões (50% da largura em telas médias+) -->
                        <div class="col-12 col-md-6">
                            <label asp-for="QuantidadeQuestoes" class="form-label fw-semibold" style="color: #0f2d59;">Qtd.
                                de Questões</label>
                                <input asp-for="QuantidadeQuestoes" type="number" class="form-control form-control-lg shadow-sm"
                                       placeholder="Ex: 10" min="1" max="100" />
                                <span asp-validation-for="QuantidadeQuestoes" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <!-- Gabarito Correto (50% da largura em telas médias+) -->
                            <div class="col-12 col-md-6">
                                <label asp-for="GabaritoCorreto" class="form-label fw-semibold" style="color: #0f2d59;">Gabarito
                                    Correto</label>
                                    <input asp-for="GabaritoCorreto" class="form-control form-control-lg shadow-sm"
                                           placeholder="Ex: ABCDE" style="text-transform: uppercase;" />
                                    <span asp-validation-for="GabaritoCorreto" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Seleção de Turma (Linha inteira) -->
                                <div class="col-12">
                                    <label asp-for="TurmaId" class="form-label fw-semibold" style="color: #0f2d59;">Turma
                                        Vinculada</label>
                                        <select asp-for="TurmaId" class="form-select form-select-lg shadow-sm">
                                            <option value="">Selecione uma turma...</option>
                                            @if (Model.TurmasDisponiveis != null)
                                            {
                                                foreach (var turma in Model.TurmasDisponiveis)
                                                {
                                                    <option value="@turma.Id">@turma.Nome</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="TurmaId" class="text-danger small mt-1 d-block"></span>
                                    </div>

                                </div>

                                <!-- Divisória -->
                                <hr class="my-4 text-muted" style="opacity: 0.15;">

                                <!-- Botões de Ação -->
                                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">

                                    <a asp-controller="Prova" asp-action="IndexProvas"
                                       class="btn btn-lg bg-white shadow-sm rounded-pill px-4 text-nowrap order-2 order-sm-1"
                                       style="color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                        <i class="bi bi-arrow-left me-2"></i>Voltar
                                    </a>

                                    <button type="submit"
                                            class="btn btn-lg text-white shadow-sm rounded-pill px-4 text-nowrap order-1 order-sm-2"
                                            style="background-color: #0f2d59; border: 2px solid #0f2d59; transition: 0.2s;">
                                        <i class="bi bi-check-lg fs-5 me-2"></i>Cadastrar Prova
                                    </button>

                                </div>

                            </div>
                        </form>

                    </div>
                </div>
  


        