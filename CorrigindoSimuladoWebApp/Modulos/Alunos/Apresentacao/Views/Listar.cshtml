@model List<ListarAlunoViewModel>
@{
    Layout = "_Layout";
    ViewBag.Titulo = "Listagem de Alunos";
}

<div class="row mt-4">
    <div class="col-12">
        <a class="btn btn-dark" asp-action="IndexAlunos">
            <i class="bi bi-arrow-return-left"></i>
            Voltar
        </a>
        <table class="table table-hover table-striped align-middle shadow-sm bg-white">
            <thead style="--bs-table-bg: #0f2d59; --bs-table-color: white;">
                <tr>
                    <th>Nº de Matrícula</th>
                    <th>Nome</th>
                    <th>Turma</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var aluno in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@aluno.NumeroDeMatricula</td>
                            <td>@aluno.Nome</td>
                            <td>@aluno.NomeTurma</td>

                            <!-- Coluna dos Botões alinhada à direita -->
                            <td class="text-end">
                                <a asp-controller="Aluno" asp-action="Editar" asp-route-id="@aluno.Id"
                                   class="btn btn-sm btn-outline-primary me-2">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>

                                <!-- Botão que abre a janela de confirmação (Modal) -->
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal"
                                        data-bs-target="#modalExcluir-@aluno.Id">
                                    <i class="bi bi-trash"></i> Excluir
                                </button>

                                <!-- Janela de Confirmação (Modal Bootstrap) -->
                                <div class="modal fade text-start" id="modalExcluir-@aluno.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">

                                            <!-- Cabeçalho do Modal -->
                                            <div class="modal-header text-white" style="background-color: #0f2d59;">
                                                <h5 class="modal-title fs-5">Confirmar Exclusão</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                                                        aria-label="Fechar"></button>
                                            </div>

                                            <!-- Corpo do Modal -->
                                            <div class="modal-body p-4 text-center">
                                                <i class="bi bi-exclamation-triangle text-warning display-4 mb-3 d-block"></i>
                                                <p class="fs-5 text-dark mb-1">
                                                    Deseja realmente excluir o aluno <strong>@aluno.Nome</strong>?
                                                </p>
                                                <span class="text-muted small">Esta ação não poderá ser desfeita.</span>
                                            </div>

                                            <!-- Rodapé do Modal (Ações) -->
                                            <div class="modal-footer bg-light justify-content-center">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                                    <i class="bi bi-arrow-return-left"></i> Voltar
                                                </button>

                                                <form asp-controller="Aluno" asp-action="Excluir" asp-route-id="@aluno.Id"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger">
                                                        <i class="bi bi-trash"></i> Sim, Excluir
                                                    </button>
                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">
                            Nenhum aluno cadastrado no momento.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>