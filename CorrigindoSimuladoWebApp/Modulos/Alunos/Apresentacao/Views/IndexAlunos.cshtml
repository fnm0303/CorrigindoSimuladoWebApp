@{
    Layout = "_Layout";
    ViewBag.Titulo = "Gestão de Alunos";
}

<div class="row gap-3 gap-lg-0 mt-5">
    <div class="col-12">

        <!-- Título do Módulo -->
        <h2 class="display-5 mb-3" style="color: #0f2d59; letter-spacing: -0.5px;">
            Módulo de Alunos
        </h2>

        <!-- Linha divisória (ajustei a largura para ficar proporcional ao título) -->
        <div style="width: 200px; height: 4px; background-color: #0f2d59; border-radius: 2px;" class="mb-4"></div>

        <!-- Descrição -->
        <p class="fs-5 text-black lh-base mb-4" style="max-width: 600px;">
            Gerencie os alunos da instituição. Cadastre novos alunos para o ano letivo, busque um aluno específico
            ou visualize a lista completa.
        </p>

        <!-- Botões de Ação -->
        <div class="d-flex flex-nowrap gap-3 mt-2">
            <!-- Botão Cadastrar (Ação principal, cor preenchida) -->
            <a asp-controller="Aluno" asp-action="Cadastrar"
               class="btn btn-lg text-white shadow-sm d-flex align-items-center text-nowrap"
               style="background-color: #0f2d59; border: none; padding: 12px 25px; transition: 0.2s;">
                <i class="bi bi-plus-circle fs-5 me-2"></i> Cadastrar Aluno
            </a>

            <!-- Botão Buscar -->
            <a asp-controller="Aluno" asp-action="Buscar"
               class="btn btn-lg bg-white shadow-sm d-flex align-items-center text-nowrap"
               style="color: #0f2d59; border: 2px solid #0f2d59; padding: 10px 25px; transition: 0.2s;">
                <i class="bi bi-search fs-5 me-2"></i> Buscar Alunos
            </a>

            <!-- Botão Listar (Ação secundária, contorno) -->
            <a asp-controller="Aluno" asp-action="Listar"
               class="btn btn-lg bg-white shadow-sm d-flex align-items-center text-nowrap"
               style="color: #0f2d59; border: 2px solid #0f2d59; padding: 10px 25px; transition: 0.2s;">
                <i class="bi bi-list-ul fs-5 me-2"></i> Listar Alunos
            </a>
        </div>
    </div>
</div>