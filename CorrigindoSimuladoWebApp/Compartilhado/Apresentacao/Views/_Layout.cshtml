<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    
    <title>@ViewBag.Titulo | Corrigindo Simulados 1.0</title>
</head>

<body style="background-color: lightgreen;">
    <nav class="navbar navbar-light bg-white shadow-sm">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <a class="navbar-brand" href="#">
                <img src="~/img/logoTipo_navBar.png" alt="Logo" width="170" height="100" class="d-inline-block align-text-top">
            </a>
            <span class="navbar-text fw-semibold text-secondary fs-5">
                versão 1.0
            </span>
        </div>
    </nav>

    <div class="d-flex" style="min-height: calc(100vh - 116px);">
        
        <!-- Menu Lateral Esquerdo -->
        <aside class="bg-white text-dark p-3 shadow-sm" style="width: 250px; min-width: 250px;">
            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a href="#" class="nav-link mb-2 text-dark" style="background-color: lightgreen;">Início</a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark mb-2">Turmas</a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark mb-2">Alunos</a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark mb-2">Provas</a>
                </li>
                <li>
                    <a href="#" class="nav-link link-dark mb-2">Correção</a>
                </li>
            </ul>
        </aside>

    <main class="container py-5">
        <header class="mb-4">
            <h1 class="display-5 fw-bold mb-3" style="color: #0f2d59; letter-spacing: -0.5px;">@ViewBag.Titulo</h1>
        </header>

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous"></script>
</body>

</html>